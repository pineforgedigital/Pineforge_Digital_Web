{
    "version": 2,
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/css/(.*)",
            "destination": "/public/css/$1"
        },
        {
            "source": "/images/(.*)",
            "destination": "/public/images/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/public/js/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/server.js"
        }
    ]
}
