{
    "version": 2,
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "/public/sitemap.xml"
        },
        {
            "source": "/robots.txt",
            "destination": "/public/robots.txt"
        },
        {
            "source": "/googleef42f328f91ef003.html",
            "destination": "/public/googleef42f328f91ef003.html"
        },
        {
            "source": "/css/(.*)",
            "destination": "/public/css/$1"
        },
        {
            "source": "/images/(.*)",
            "destination": "/public/images/$1"
        },
        {
            "source": "/js/(.*)",
            "destination": "/public/js/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/server.js?vpath=$1"
        }
    ]
}
